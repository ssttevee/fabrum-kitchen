.{
    .name = .fabrum_kitchen,
    .version = "0.0.0",
    .fingerprint = 0x52637f29fa42c6cc,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .fabrum = .{
            .path = "../zig-layout",
        },
        // Only the macOS GUI uses it.
        .fabrum_renderer_quartz = .{
            .path = "../zig-fabrum-renderer-quartz",
        },
        // kitchen-none draws with one of these (-Drenderer).
        .fabrum_renderer_z2d = .{
            .path = "../zig-fabrum-renderer-z2d",
            .lazy = true,
        },
        .fabrum_renderer_thorvg = .{
            .path = "../zig-fabrum-renderer-thorvg",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
